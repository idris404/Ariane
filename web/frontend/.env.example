# Origine du backend FastAPI : sans slash final ni préfixe /api/v1 (voir src/constants/api.ts).
# En production Vercel Services, utiliser /api/backend pour passer par la route même origine.
# Lue par src/core/env.ts. Tout NEXT_PUBLIC_* est embarqué dans le bundle : jamais de secret ici.
# Copier ce fichier en .env pour le développement local.
NEXT_PUBLIC_API_URL=http://localhost:8000
